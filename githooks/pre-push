#!/bin/bash
# Checks every commit about to be pushed. Enabled with: git config core.hooksPath githooks
ZERO="0000000000000000000000000000000000000000"
CHECK="$(git rev-parse --show-toplevel)/githooks/check-safe.sh"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # deleting a branch publishes nothing
  base="$remote_sha"
  [ "$base" = "$ZERO" ] && base="" # new branch: check its whole history
  # After a history rewrite the old remote tip is not an ancestor: check everything.
  [ -n "$base" ] && ! git merge-base --is-ancestor "$base" "$local_sha" 2>/dev/null && base=""
  "$CHECK" range "$base" "$local_sha" || status=1
done
exit $status
